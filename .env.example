# ─────────────────────────────────────────────────────────────
# ASPOR.GE — environment variables (PLACEHOLDERS ONLY — never commit real values)
# Copy to .env for local development. In production set these in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL). Neon: use the *pooled* connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/aspor?sslmode=require"
# Direct (non-pooled) URL for `prisma migrate deploy`
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aspor?sslmode=require"
# Used only by the test suites (separate, disposable database)
TEST_DATABASE_URL="postgresql://aspor:aspor_dev@localhost:5432/aspor_test"

# Public site URL (used for canonical URLs, sitemap, emails)
APP_URL="https://aspor.ge"
NEXT_PUBLIC_SITE_URL="https://aspor.ge"

# Secrets — generate each with:  openssl rand -base64 48
APP_ENCRYPTION_KEY="REPLACE_ME_min_32_chars"   # encrypts admin TOTP secrets (AES-256-GCM). Rotating it invalidates MFA enrolment.
SESSION_SECRET="REPLACE_ME_min_32_chars"       # HMAC for IP hashing & anti-spam form tickets

# Admin MFA (TOTP). Keep "true" in every non-local environment.
ADMIN_MFA_REQUIRED="true"

# Transactional email: "console" (dev: logs only) | "resend"
EMAIL_PROVIDER="console"
EMAIL_FROM="ASPOR <no-reply@aspor.ge>"         # domain must be verified in Resend
RESEND_API_KEY=""
ADMIN_NOTIFY_EMAIL=""                           # receives new application / contact notifications

# File storage: "local" (dev only, writes to public/uploads) | "s3" (Cloudflare R2 or any S3-compatible)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""                                  # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""                      # e.g. https://media.aspor.ge (R2 custom domain)

# Claude translation (optional — CMS shows a disabled state when empty)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""                              # a current model ID from https://docs.claude.com/en/docs/about-claude/models

# Vercel Cron → /api/cron/emails (email retries)
CRON_SECRET="REPLACE_ME"

# Analytics — leave empty until you have real IDs. Loaded only after visitor consent.
NEXT_PUBLIC_GA4_ID=""                           # G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""                    # digits only
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""         # Search Console HTML-tag token

# Seed (run once): creates the super-admin. Remove from env afterwards.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""                          # ≥12 chars, letters + digits
# Local demo only — NEVER in production:
# SEED_PUBLISH_DEMO=1
# SEED_APPROVE_DEMO_EN=1
