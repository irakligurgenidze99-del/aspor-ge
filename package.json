{
  "name": "aspor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:sandbox:deploy": "node --no-warnings scripts/prisma-wasm.mjs deploy",
    "db:sandbox:reset": "node --no-warnings scripts/prisma-wasm.mjs reset",
    "postinstall": "prisma generate",
    "vercel-build": "bash scripts/vercel-build.sh",
    "db:ops": "tsx --conditions=react-server prisma/content-ops.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@prisma/driver-adapter-utils": "^7.10.1",
    "@prisma/schema-engine-wasm": "^8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "22.x"
  }
}
